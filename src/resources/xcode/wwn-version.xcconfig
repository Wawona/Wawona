#include? "../../../.deps/xrsimulator/Wawona.xcconfig"
#include? "../../../.deps/watchos/Wawona.xcconfig"
#include? "../../../.deps/watchsimulator/Wawona.xcconfig"
// DEVELOPMENT_TEAM, untracked.
