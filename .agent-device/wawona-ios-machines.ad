# Machines Start session — uses stable wwn.* ids (no coordinate taps).
context platform=ios
context session=wawona-ios-machines
context device=iPhone 17 Pro

open com.aspauldingcode.Wawona --relaunch
wait 2000
screenshot ./.agent-device/test-artifacts/ios-machines-root.png
press id="wwn.machines.start"
wait 8000
screenshot ./.agent-device/test-artifacts/ios-weston-session.png
close
