# iOS native shell CLI smoke (Residual F): open the bundled weston-terminal in a
# native machine session and exercise the in-process commands that must dispatch
# without fork/exec (whoami, ls, fastfetch, ssh, apt).
#
# Default Machine must be weston-terminal (not nested weston). Seed with
# scripts/agent-device-set-client-ios.sh weston-terminal, then write the
# profiles key as JSON NSData if the card still says "Runs: Weston".
#
# Coordinate taps are pinned to the iPhone 17 Pro logical size (402x874);
# compositor/terminal surfaces expose no accessibility nodes, so screenshots are
# the source of truth. Re-validate coordinates with `snapshot -i --json` if the
# root layout changes. Text is delivered with `type`; `keyboard return` submits
# each command line to the PTY.
context platform=ios
context session=wawona-ios-shell-cli
context device=iPhone 17 Pro

open com.aspauldingcode.Wawona --relaunch
wait 3000
screenshot ./.agent-device/test-artifacts/ios-shell-cli-root.png

# Start the Default Machine (bundled weston-terminal, in-process compositor).
click 69 374
wait 10000
screenshot ./.agent-device/test-artifacts/ios-shell-cli-terminal.png

# Focus the terminal surface so the software keyboard/PTY receives input.
click 201 437
wait 800

# whoami — coreutils identity (must not panic on the sandbox getpwuid path).
type "whoami"
keyboard return
wait 1000
screenshot ./.agent-device/test-artifacts/ios-shell-cli-whoami.png

# ls / echo — baseline coreutils dispatch.
type "ls /"
keyboard return
wait 800
type "echo wawona-smoke-ok"
keyboard return
wait 800
screenshot ./.agent-device/test-artifacts/ios-shell-cli-coreutils.png

# fastfetch — bundled client archive dispatch.
type "fastfetch --version"
keyboard return
wait 1500
screenshot ./.agent-device/test-artifacts/ios-shell-cli-fastfetch.png

# ssh — libssh2 CLI (libwwn-ssh-cli.a); must not exit 127 / NOT_HANDLED.
type "ssh -V"
keyboard return
wait 1200
screenshot ./.agent-device/test-artifacts/ios-shell-cli-ssh.png

# ssh-keygen — OpenSSH-format key under /tmp (in-process OpenSSL).
type "ssh-keygen -t ed25519 -f /tmp/wawona-ad-id -N '' -q && ssh-keygen -l -f /tmp/wawona-ad-id"
keyboard return
wait 2000
screenshot ./.agent-device/test-artifacts/ios-shell-cli-ssh-keygen.png

# apt — in-process module front-end (App Store compliant, no exec).
type "apt help"
keyboard return
wait 1000
screenshot ./.agent-device/test-artifacts/ios-shell-cli-apt.png

# zsh/sh identity: PATH stubs must resolve (not command-not-found).
type "command -v zsh"
keyboard return
wait 800
type "command -v sh"
keyboard return
wait 800
type "type zsh"
keyboard return
wait 800
screenshot ./.agent-device/test-artifacts/ios-shell-cli-zsh-identity.png

# New .sh + chmod +x + path matrix (sourced by in-process zsh).
type "echo 'echo hello-rel' > example.sh"
keyboard return
wait 800
type "chmod +x example.sh"
keyboard return
wait 800
type "./example.sh"
keyboard return
wait 800
screenshot ./.agent-device/test-artifacts/ios-shell-cli-script-chmod.png

type "sh example.sh"
keyboard return
wait 800
type "zsh example.sh"
keyboard return
wait 800
type "sh ./example.sh"
keyboard return
wait 800
type "zsh \"$PWD/example.sh\""
keyboard return
wait 800
# Path is a command, like macOS zsh. No sh / wasm prefix.
type "example.sh"
keyboard return
wait 800
type "\"$PWD/example.sh\""
keyboard return
wait 800
type "chmod -x example.sh && example.sh"
keyboard return
wait 800
type "[[ -f hello.wasm ]] && hello.wasm && ./hello.wasm && \"$PWD/hello.wasm\""
keyboard return
wait 2500
screenshot ./.agent-device/test-artifacts/ios-shell-cli-script-paths.png

type "source ~/.zshrc"
keyboard return
wait 800
type "zsh -c 'echo hello-c'"
keyboard return
wait 1000
screenshot ./.agent-device/test-artifacts/ios-shell-cli-script-source.png

close
