# Nested niri + fuzzel (Mod+D) GUI e2e — Android.
#
# Prereq (scripts/agent-device-fuzzel-smoke.sh sets this): Default Machine
# nativeLauncher=niri in SharedPreferences. Use label selectors so Start is
# not missed when the emulator skin differs from the old 1080x2424 frame.
#
# Alt+D is injected by the smoke wrapper after this replay returns.
context platform=android
context session=wawona-android-niri-fuzzel

open com.aspauldingcode.wawona --relaunch
wait 4000
screenshot ./.agent-device/test-artifacts/android-fuzzel-e2e-01-home.png

press label="Continue"
wait 1500
screenshot ./.agent-device/test-artifacts/android-fuzzel-e2e-02-machines.png

press label="Got it"
wait 500

# Ensure All Machines filter (Remote tap was a prior false-positive from coords).
press label="All Machines"
wait 500

press label="Start"
wait 12000
screenshot ./.agent-device/test-artifacts/android-fuzzel-e2e-03-niri-starting.png

# Dismiss "Starting niri" Done overlay and immersive coach mark when present.
press label="Done"
wait 1000
press label="Got it"
wait 500

screenshot ./.agent-device/test-artifacts/android-fuzzel-e2e-04-niri-focused.png

# Leave session open — smoke.sh injects Alt+D next, then re-snapshots.
