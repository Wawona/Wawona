# Android machines lane — stable wwn.* ids (Compose testTagsAsResourceId).
context platform=android
context session=wawona-android-machines

open com.aspauldingcode.wawona --relaunch
wait 4000
screenshot ./.agent-device/test-artifacts/android-first-screen.png
press id="wwn.welcome.continue"
wait 2000
wait id="wwn.machines.root" 20000
screenshot ./.agent-device/test-artifacts/android-machines-root.png
press id="wwn.machines.settings"
wait id="wwn.settings.display" 15000
press id="wwn.settings.display"
wait 800
screenshot ./.agent-device/test-artifacts/android-settings-display.png
press id="wwn.settings.done"
wait 1000
press id="wwn.machines.add"
wait 1500
screenshot ./.agent-device/test-artifacts/android-add-machine-sheet.png
back
wait 1000
press id="wwn.machines.start"
wait 10000
screenshot ./.agent-device/test-artifacts/android-weston-session.png
close
