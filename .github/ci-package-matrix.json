{
  "description": "Curated Gate: packages package matrix. Product binaries (wawona-macos, wawona-appimage, wawona-ios, wawona-android) are owned by product-build.yml — see docs/ci.md.",
  "include": [
    {
      "system": "aarch64-darwin",
      "os": "macos-26",
      "target": "wawona-ios-sim-backend",
      "why": "iOS sim Rust/native backend (product-build .#wawona-ios path); app install covered by product-build + device-e2e"
    },
    {
      "system": "aarch64-darwin",
      "os": "macos-26",
      "target": "wawona-android-backend",
      "why": "Android native backend on Darwin host (NDK path)"
    },
    {
      "system": "aarch64-darwin",
      "os": "macos-26",
      "target": "weston-ios",
      "why": "Layer-1 nested compositor stack; FlakeHub cross-repo hit target"
    },
    {
      "system": "aarch64-darwin",
      "os": "macos-26",
      "target": "zsh-ios",
      "why": "In-process shell / rootfs wiring smoke"
    },
    {
      "system": "aarch64-darwin",
      "os": "macos-26",
      "target": "niri-ios",
      "why": "Bundled nested compositor used by fuzzel e2e"
    },
    {
      "system": "aarch64-darwin",
      "os": "macos-26",
      "target": "graphics-validate-macos",
      "why": "Graphics/driver sanity check (L2)"
    },
    {
      "system": "x86_64-linux",
      "os": "ubuntu-latest",
      "target": "wawona-linux-ui-bin",
      "why": "Linux GTK host UI binary (AppImage input; AppImage itself is product-build)"
    },
    {
      "system": "x86_64-linux",
      "os": "ubuntu-latest",
      "target": "wawona-android-backend",
      "why": "Android backend also builds on Linux CI hosts"
    },
    {
      "system": "x86_64-linux",
      "os": "ubuntu-latest",
      "target": "weston",
      "why": "Linux Weston client/compositor packaging"
    },
    {
      "system": "aarch64-linux",
      "os": "ubuntu-24.04-arm",
      "target": "wawona-linux-ui-bin",
      "why": "aarch64 Linux UI binary"
    }
  ]
}
