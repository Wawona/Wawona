# Copy to .release-secrets.env (gitignored) and fill in values.
# Store key files under .secrets/ (also gitignored) or anywhere outside the repo.
#
#   mkdir -p .secrets
#   cp .release-secrets.env.template .release-secrets.env
#
# Then:
#   ./scripts/sync-github-secrets.sh --apple-only   # Apple/TestFlight only (skip Android until Play is ready)
#   ./scripts/bootstrap-apple-signing.sh          # first-time Apple certs (2FA possible)
#   ./scripts/sync-github-secrets.sh              # full sync when Android/Play secrets are ready
#
# How to obtain each value — see docs below or fastlane/README.md

# --- Apple Developer / fastlane match ---------------------------------------

# Apple ID email for your Developer account (same login as developer.apple.com)
APPLE_ID=

# 10-character Team ID — developer.apple.com/account → Membership → Team ID
# Or: Xcode → Settings → Accounts → select team → Team ID in detail pane
TEAM_ID=

# Password YOU choose to encrypt the match repo (aspauldingcode/apple-signing).
# Not an Apple password. Pick a strong passphrase; same value goes to GitHub as MATCH_PASSWORD.
MATCH_PASSWORD=

# Fine-grained GitHub PAT — Settings → Developer settings → Fine-grained tokens
# Repository access: ONLY aspauldingcode/apple-signing
# Permissions: Contents → Read
# Used by CI to clone match certs (derived → MATCH_GIT_BASIC_AUTHORIZATION)
APPLE_SIGNING_PAT=

# --- App Store Connect API (TestFlight uploads) -------------------------------

# Path to downloaded .p8 key (never commit). Default: .secrets/AuthKey.p8
# Create at: appstoreconnect.apple.com → Users and Access → Integrations → App Store Connect API
# → Team Keys → + → name "Wawona CI", role Admin or App Manager → Download (once)
ASC_P8_PATH=.secrets/AuthKey.p8

# Key ID shown next to the key (10 chars, e.g. ABC123DEF4)
ASC_KEY_ID=

# Issuer ID at top of the API Keys page (UUID)
ASC_ISSUER_ID=

# --- Android Play App Signing (upload key) ------------------------------------

# Path to upload keystore (never commit). Default: .secrets/wawona-upload.keystore
# Generate once:
#   keytool -genkeypair -v -keystore .secrets/wawona-upload.keystore -alias wawona-upload \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
# Register the upload key in Play Console → App → Setup → App signing
ANDROID_KEYSTORE_PATH=.secrets/wawona-upload.keystore

# Passwords you chose when running keytool
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=wawona-upload
ANDROID_KEY_PASSWORD=

# --- Google Play (internal track uploads) -------------------------------------

# Service account JSON from Google Cloud (never commit).
# Play Console → Setup → API access → Link project → Create service account
# → Grant "Release to testing tracks" (or Admin) → Create key → JSON download
# Example path: .secrets/play-store.json
PLAY_JSON_PATH=.secrets/play-store.json

# Optional overrides for sync script
# GITHUB_REPO=Wawona/Wawona
# GITHUB_ENV=release-beta
