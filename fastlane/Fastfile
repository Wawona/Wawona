# frozen_string_literal: true

require "fileutils"
require "shellwords"
require "tmpdir"

default_platform(:ios)

# --- Common helpers ---

def check_env(vars)
  missing = vars.select { |v| ENV[v].nil? || ENV[v].to_s.empty? }
  UI.user_error!(
    "Missing environment variables: #{missing.join(', ')}. " \
    "See docs/maintainers/secrets.md (tier 0) or secretspec.toml."
  ) unless missing.empty?
end

desc "Sync version from VERSION file to Cargo.toml and Android build.gradle.kts"
lane :sync_version do
  version = wawona_version
  UI.message("Syncing version #{version} to platform manifests...")

  cargo_toml = File.expand_path("../Cargo.toml", __dir__)
  cargo_content = File.read(cargo_toml)
  File.write(cargo_toml, cargo_content.gsub(/^version = ".*"$/, "version = \"#{version}\""))

  gradle_path = File.expand_path("../android/app/build.gradle.kts", __dir__)
  if File.exist?(gradle_path)
    gradle_content = File.read(gradle_path)
    File.write(gradle_path, gradle_content.gsub(/versionName = ".*"$/, "versionName = \"#{version}\""))
  end

  UI.success("Versions synced to #{version}")
end

desc "Verify release environment (Apple credentials)"
lane :validate_env do
  check_env(%w[
    TEAM_ID
    APP_STORE_CONNECT_KEY_ID
    APP_STORE_CONNECT_ISSUER_ID
    APP_STORE_CONNECT_API_KEY
  ])
  UI.success("Environment validated")
end

desc "Enable iCloud on App IDs and force-regenerate App Store match profiles"
lane :regenerate_signing do
  validate_env
  setup_ci if ENV["CI"]
  ENV["MATCH_FORCE"] = "1"
  ENV["MATCH_READONLY"] = "0"
  api_key = asc_api_key
  install_testflight_profiles!(api_key)
  UI.success("App Store profiles regenerated (iCloud-capable). apple-signing repo updated.")
end

# TestFlight targets (macOS excluded — not distributed via TestFlight).
# gym builds via scheme; match profiles must already include App Store + iCloud.
#
# watchOS is a companion (WKCompanionAppBundleIdentifier → com.aspauldingcode.Wawona).
# A bare watchOS archive has no App Store export method on Xcode 26
# (`expected one {} but found app-store`). Ship watch by embedding into
# Wawona-iOS under XcodeGen's own default Watch/ location — see
# xcodegen.nix's #ITMS-90426-watch comment for why PlugIns/ was tried and
# reverted (breaks `xcrun altool` upload). Never gym Wawona-watchOS alone.
APPLE_BETA_TARGETS = [
  {
    # Universal (phone+iPad). Do not also upload Wawona-iPadOS — same bundle id
    # and CFBundleVersion would collide on the IOS App Store Connect platform.
    # Watch companion rides inside this IPA (xcodegen embed + gym_ipa signing).
    # Never gym Wawona-watchOS standalone for TF (#136).
    scheme: "Wawona-iOS",
    name: "iPhone + iPad (iOS)",
    app_platform: "ios",
    destination: "generic/platform=iOS",
    bundle_id: "com.aspauldingcode.Wawona",
    profile_name: "match AppStore com.aspauldingcode.Wawona"
  },
  {
    scheme: "Wawona-tvOS",
    name: "Apple TV (tvOS)",
    app_platform: "appletvos",
    destination: "generic/platform=tvOS",
    bundle_id: "com.aspauldingcode.Wawona",
    profile_name: "match AppStore com.aspauldingcode.Wawona tvos"
  },
  {
    scheme: "Wawona-visionOS",
    name: "Apple Vision Pro (visionOS)",
    app_platform: "xros",
    destination: "generic/platform=visionOS",
    bundle_id: "com.aspauldingcode.Wawona",
    profile_name: "match AppStore com.aspauldingcode.Wawona"
  }
].freeze

# Optional comma-separated scheme filter (e.g. WAWONA_BETA_SCHEMES=Wawona-iOS)
# for ios-only Ship: beta while diagnosing tvOS/visionOS export separately.
def apple_beta_targets
  schemes = ENV.fetch("WAWONA_BETA_SCHEMES", "")
               .split(",")
               .map(&:strip)
               .reject(&:empty?)
  return APPLE_BETA_TARGETS if schemes.empty?

  selected = APPLE_BETA_TARGETS.select { |t| schemes.include?(t[:scheme]) }
  UI.user_error!("WAWONA_BETA_SCHEMES=#{schemes.inspect} matched no APPLE_BETA_TARGETS") if selected.empty?
  selected
end

MAIN_BUNDLE_ID = "com.aspauldingcode.Wawona"
WATCH_BUNDLE_ID = "com.aspauldingcode.Wawona.watch"
WATCH_PROFILE_NAME = "match AppStore com.aspauldingcode.Wawona.watch"
BETA_FEEDBACK_EMAIL = ENV.fetch("BETA_FEEDBACK_EMAIL", "aspauldingcode@gmail.com")

def beta_testflight_groups
  ENV.fetch("BETA_TESTFLIGHT_GROUPS", "")
     .split(",")
     .map(&:strip)
     .reject(&:empty?)
end

def testflight_wait_timeout_seconds
  Integer(ENV.fetch("TESTFLIGHT_WAIT_TIMEOUT", "2700"))
end

def testflight_upload_options(api_key, target)
  # IMPORTANT: do NOT pass `changelog` when skip_waiting is true.
  # pilot still polls until the build appears whenever changelog is set, and
  # if ASC discards the binary (privacy manifest / invalid build) that wait
  # never ends (see Ship: beta (stores) #60: 4.5h hang on build 60).
  opts = {
    api_key: api_key,
    app_identifier: target[:bundle_id],
    app_platform: target[:app_platform],
    beta_app_feedback_email: BETA_FEEDBACK_EMAIL,
    skip_waiting_for_build_processing: true,
    wait_processing_timeout_duration: testflight_wait_timeout_seconds
  }
  groups = beta_testflight_groups
  if groups.any?
    opts[:groups] = groups
    opts[:distribute_external] = true
    opts[:notify_external_testers] = true
    opts[:skip_waiting_for_build_processing] = false
    opts[:changelog] = "Wawona #{wawona_version} (#{wawona_build_number}) beta"
  end
  opts
end

# Refuse upload if the IPA still imports libSystem's private ___progname.
def assert_ipa_no_private_progname!(ipa)
  require "open3"
  UI.message("Checking #{File.basename(ipa)} for private ___progname…")
  Dir.mktmpdir("wawona-ipa-progname") do |dir|
    sh("unzip -q #{ipa.shellescape} -d #{dir.shellescape}")
    app = Dir.glob(File.join(dir, "Payload", "*.app")).first
    UI.user_error!("No Payload/*.app in #{ipa}") unless app
    plist = File.join(app, "Info.plist")
    exe_name, st = Open3.capture2(
      "/usr/libexec/PlistBuddy", "-c", "Print :CFBundleExecutable", plist
    )
    exe_name = exe_name.to_s.strip
    UI.user_error!("CFBundleExecutable missing in #{plist}") unless st.success? && !exe_name.empty?
    bin = File.join(app, exe_name)
    UI.user_error!("Missing executable #{bin}") unless File.file?(bin)
    undefs, st = Open3.capture2("nm", "-u", bin)
    UI.user_error!("nm -u failed for #{bin}") unless st.success?
    if undefs.include?("___progname")
      UI.user_error!(
        "#{exe_name} imports private ___progname — App Store Connect will reject " \
        "the binary. Fix OpenSSH / getprogname stubs before uploading."
      )
    end
    UI.success("#{exe_name}: no ___progname undefined import")
  end
end

# Hard pre-upload Swift Support gate (#build119). The rule, reverse-
# engineered from ASC's own per-build errors (buildUploads API, builds
# 89-119) and encoded in SWIFT_BACKDEPLOY_LIB_NAMES' comment:
#
#   * Watch-bearing IPA → ASC runs the LEGACY Swift packaging validator.
#     REQUIRED: SwiftSupport/iphoneos + SwiftSupport/watchos, each holding
#     exactly the legacy expected set (referenced ∩ swift-5.0/<plat>), each
#     name mirrored in that bundle's own Frameworks/, SwiftSupport copies
#     byte-identical to the Apple-signed toolchain originals (ITMS-90433:
#     never re-signed). Anything else fails HERE, before upload — never
#     hours later via an Apple e-mail.
#   * Watchless IPA → ABI-stable shape; SwiftSupport/ must be absent unless
#     a genuine back-deployment dylib is embedded (accepted tvOS/visionOS
#     shape — builds 118/119 state=COMPLETE).
#
# Gym 2.232 also rewrites ExportOptions to deprecated app-store — we bypass
# that with a manual exportArchive (method: app-store-connect).
def assert_ipa_has_swift_support!(ipa)
  require "open3"
  listing, st = Open3.capture2("unzip", "-Z1", ipa)
  UI.user_error!("unzip -Z1 failed for #{ipa}") unless st.success?
  has_support = listing.lines.any? { |l| l.start_with?("SwiftSupport/") }
  has_watch = listing.lines.any? { |l| l.include?("/Watch/") && l.include?(".app/") }

  if has_watch
    unless has_support
      UI.user_error!(
        "#{File.basename(ipa)} contains a Watch companion but no SwiftSupport/ — ASC's legacy " \
        "validator WILL reject this as ITMS-90426 (exactly builds 110/119). " \
        "Check embed_swift_runtime_into_archive!/inject_swift_support_from_archive!."
      )
    end
    assert_legacy_swift_support!(ipa)
    return
  end

  needs_support = listing.lines.any? do |l|
    path = l.strip
    path.include?("/Frameworks/") && SWIFT_BACKDEPLOY_LIB_NAMES.any? { |n| path.end_with?("/#{n}") }
  end
  unless has_support
    if needs_support
      UI.user_error!(
        "#{File.basename(ipa)} embeds a Swift back-deployment dylib under Frameworks/ but is " \
        "missing SwiftSupport/ (ITMS-90426). Check inject_swift_support_from_archive!."
      )
    end
    UI.important("#{File.basename(ipa)}: watchless, no back-deployment dylib; SwiftSupport/ correctly absent (accepted ABI-stable shape)")
    return
  end
  UI.success("#{File.basename(ipa)}: SwiftSupport/ present")
  assert_swift_support_frameworks_parity!(ipa)
end

# Deep validation of the legacy Swift Support invariant for a watch-bearing
# IPA — inspects the actual zip contents, never trusts prior build steps.
def assert_legacy_swift_support!(ipa)
  require "open3"
  Dir.mktmpdir("wawona-legacy-ss-check") do |dir|
    sh("unzip -q #{ipa.shellescape} -d #{dir.shellescape}")
    app = Dir.glob(File.join(dir, "Payload", "*.app")).first
    UI.user_error!("No Payload/*.app in #{File.basename(ipa)}") unless app

    dt_platform, = Open3.capture2("/usr/libexec/PlistBuddy", "-c", "Print :DTPlatformName", File.join(app, "Info.plist"))
    main_platform = dt_platform.to_s.strip == "appletvos" ? "appletvos" : "iphoneos"
    bundles = { main_platform => app }
    Dir.glob(File.join(app, "Watch", "*.app")).each { |w| bundles["watchos"] = w }

    problems = []
    bundles.each do |plat, bundle_dir|
      expected = legacy_swift_expected_names(bundle_dir, plat).sort
      ss_dir = File.join(dir, "SwiftSupport", plat)
      actual = Dir.glob(File.join(ss_dir, "*.dylib")).map { |l| File.basename(l) }.sort
      problems << "SwiftSupport/#{plat}: expected #{expected.join(', ')} — found #{actual.empty? ? '(nothing)' : actual.join(', ')}" if actual != expected

      expected.each do |name|
        fw_copy = File.join(bundle_dir, "Frameworks", name)
        problems << "#{File.basename(bundle_dir)}/Frameworks/#{name} missing (ITMS-90429/90427)" unless File.file?(fw_copy)

        ss_copy = File.join(ss_dir, name)
        tc_copy = File.join(swift50_toolchain_dir(plat), name)
        if File.file?(ss_copy) && !FileUtils.compare_file(ss_copy, tc_copy)
          problems << "SwiftSupport/#{plat}/#{name} differs from the Apple-signed toolchain original (ITMS-90433 — must never be re-signed)"
        end
      end
    end

    unless problems.empty?
      UI.user_error!(
        "#{File.basename(ipa)}: legacy Swift Support invariant violated — refusing to upload:\n  - #{problems.join("\n  - ")}"
      )
    end
    UI.success("#{File.basename(ipa)}: legacy Swift Support invariant OK (#{bundles.keys.sort.join(' + ')}; Frameworks parity + Apple-signed SwiftSupport verified)")
  end
end

# #136 / #ITMS-90426-watch: iOS App Store IPA must carry the watch companion
# under Watch/ — XcodeGen's own unpatched default embed location. See
# dependencies/generators/xcodegen.nix's #ITMS-90426-watch comment for the
# full history of why PlugIns/ (dstSubfolderSpec=13) was tried and reverted.
def assert_ipa_has_watch_companion!(ipa)
  if ENV["WAWONA_SKIP_WATCH"].to_s == "1"
    UI.important("WAWONA_SKIP_WATCH=1 — skipping Watch/ companion assert")
    return
  end
  require "open3"
  listing, st = Open3.capture2("unzip", "-Z1", ipa)
  UI.user_error!("unzip -Z1 failed for #{ipa}") unless st.success?
  # #ITMS-90426-watch (2026-08-08): PlugIns/ (dstSubfolderSpec=13) archives
  # and exports fine but breaks `xcrun altool`/`upload_to_testflight` outright
  # ("Cannot determine the 'platform' from the info.plist.") — see
  # dependencies/generators/xcodegen.nix for the full history. Back to
  # XcodeGen's own default Watch/ (dstSubfolderSpec=16), which every build
  # 89-110 uploaded successfully; only SwiftSupport content ever caused a
  # real ASC rejection for this app, never the embed directory.
  watch_app = listing.lines.any? do |l|
    l.include?("/Watch/") && l.include?(".app/")
  end
  unless watch_app
    UI.user_error!(
      "#{File.basename(ipa)} is missing Payload/*/Watch/*.app (#136)."
    )
  end
  UI.success("#{File.basename(ipa)}: Watch/ companion present")
end

# Names of /usr/lib/swift/lib*.dylib the binary's LC_LOAD_DYLIB commands
# reference. IMPORTANT: this returns *every* Swift ABI overlay the binary
# links (libswiftCore, libswiftDarwin, libswiftDispatch, …) — for an
# ABI-stable app (deployment target ≥ iOS/tvOS 12.2, watchOS 5.1.1) these are
# *always* referenced by absolute OS path and are provided by the OS itself
# at every deployment target we ship; most show up "weak" in `otool -L`.
# Never treat plain membership in this list as "needs embedding" — see
# `SWIFT_BACKDEPLOY_LIB_NAMES` below for the actual (narrow) set Apple
# expects bundled, and only when the deployment target requires it.
def swift_runtime_dep_names(binary_path)
  require "open3"
  out, st = Open3.capture2("otool", "-L", binary_path)
  UI.user_error!("otool -L failed for #{binary_path}") unless st.success?
  out.lines.filter_map do |line|
    m = line.match(%r{/usr/lib/swift/(lib[\w.]+\.dylib)})
    m && m[1]
  end.uniq
end

# #build119 — the ACTUAL Swift Support rule for this app, empirically
# reverse-engineered from ASC's own rejections (builds 89-119):
#
#   * Watchless IPAs (tvOS, visionOS, iOS without companion): ABI-stable, no
#     SwiftSupport/ and no embedded libswift* — CONFIRMED ACCEPTED (builds
#     118/119 tvOS + visionOS state=COMPLETE via the buildUploads API).
#   * Watch-bearing IPAs: ASC applies the LEGACY (pre-ABI-stability) Swift
#     packaging algorithm, deployment targets notwithstanding. Build 110 and
#     119 shipped textbook ABI-stable IPAs (all refs /usr/lib/swift/*, minos
#     iOS 17 / watchOS 10, clean DT* metadata, Watch/ embed) → both rejected
#     ITMS-90426 "SwiftSupport folder is missing", while the identical-code
#     watchless IPAs of the same builds were accepted. The rejection e-mails
#     for earlier builds spell out the exact expected content:
#       - build 95 (ITMS-90429) listed libswiftDarwin, Dispatch,
#         CoreFoundation, Metal, Core, simd, QuartzCore, os, ObjectiveC,
#         CoreImage as "not at the expected location /Payload/Wawona.app/
#         Frameworks" — that list is PRECISELY the /usr/lib/swift/ names our
#         main executable references (weak included) intersected with the
#         toolchain's swift-5.0/iphoneos directory listing. ASC computed it
#         from our own binary with the legacy algorithm.
#       - build 89 (ITMS-90433) rejected a hand-mangled signature on an
#         embedded libswiftCore ("Don't just modify the code signature…").
#     So for a watch-bearing IPA, ASC requires, per platform bundle:
#       Frameworks/libswiftX.dylib   (re-signed with the app's identity, the
#                                     way Xcode's swift-stdlib-tool would)
#       SwiftSupport/<plat>/libswiftX.dylib (byte-identical Apple-signed
#                                     toolchain originals, NEVER re-signed)
#     with X = referenced ∩ swift-5.0/<plat>. See
#     `legacy_swift_expected_names` / `embed_swift_runtime_into_archive!`.
#
# The narrow back-deployment whitelist below still governs WATCHLESS bundles
# (where it correctly selects nothing at our deployment targets — keep it
# that way; tvOS/visionOS are accepted precisely in that shape).
SWIFT_BACKDEPLOY_LIB_NAMES = %w[
  libswiftCompatibility50.dylib
  libswiftCompatibility51.dylib
  libswiftCompatibility56.dylib
  libswiftCompatibilityConcurrency.dylib
  libswiftCompatibilityDynamicReplacements.dylib
  libswiftCompatibilitySpan.dylib
  libswift_Concurrency.dylib
  libswift_StringProcessing.dylib
  libswift_RegexParser.dylib
].freeze

# Whether `name` is actually needed at `min_os_major` for `platform_subdir`.
# Concurrency shipped natively in iOS/tvOS 15, watchOS 8 (macOS 12); Span
# shipped natively in OS 26 across every Apple platform (Swift 6.2). Below
# their native floor, apps need the compat shim; at or above it, the OS
# provides the real thing and bundling is not just unneeded but wrong (see
# the `SWIFT_BACKDEPLOY_LIB_NAMES` comment above for why "wrong" matters).
# Unrecognized-but-whitelisted names (the legacy Swift 5.x Compatibility5x/
# DynamicReplacements/StringProcessing/RegexParser shims) are trusted from
# whitelist membership alone — narrow, Apple-defined, never the broad base
# runtime overlay list.
def swift_backdeploy_needed?(name, min_os_major, platform_subdir)
  case name
  when "libswift_Concurrency.dylib", "libswiftCompatibilityConcurrency.dylib"
    min_os_major < (platform_subdir == "watchos" ? 8 : 15)
  when "libswiftCompatibilitySpan.dylib"
    min_os_major < 26
  else
    true
  end
end

# Locates `name` under any Xcode toolchain swift-<ver>/<platform_subdir> dir
# (back-deploy shims live in different swift-<ver> dirs by Swift version they
# were introduced in — e.g. libswift_Concurrency.dylib under swift-5.5,
# libswiftCompatibilitySpan.dylib under swift-6.2 — never assume swift-5.0).
def xcode_swift_lib_source(name, platform_subdir)
  dev_dir = (
    ENV["DEVELOPER_DIR"].to_s.empty? ? `xcode-select -p`.strip : ENV["DEVELOPER_DIR"]
  )
  toolchain_lib = File.join(dev_dir, "Toolchains/XcodeDefault.xctoolchain/usr/lib")
  Dir.glob(File.join(toolchain_lib, "swift-*", platform_subdir, name)).first
end

# The GM toolchain's legacy Swift runtime dir for one platform — the exact
# corpus ASC's legacy watch-bearing algorithm intersects against (#build119).
def swift50_toolchain_dir(platform_subdir)
  dev_dir = (
    ENV["DEVELOPER_DIR"].to_s.empty? ? `xcode-select -p`.strip : ENV["DEVELOPER_DIR"]
  )
  File.join(dev_dir, "Toolchains/XcodeDefault.xctoolchain/usr/lib/swift-5.0", platform_subdir)
end

# All Mach-O code items of a bundle whose /usr/lib/swift references count
# toward ASC's legacy expected set: the main executable plus every nested
# Frameworks binary (framework executables and loose dylibs).
def bundle_swift_ref_names(bundle_dir)
  require "open3"
  plist = File.join(bundle_dir, "Info.plist")
  exe, = Open3.capture2("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleExecutable", plist)
  binaries = [File.join(bundle_dir, exe.to_s.strip)]
  binaries += Dir.glob(File.join(bundle_dir, "Frameworks", "*.dylib"))
  Dir.glob(File.join(bundle_dir, "Frameworks", "*.framework")) do |fw|
    fw_exe = File.join(fw, File.basename(fw, ".framework"))
    binaries << fw_exe if File.file?(fw_exe)
  end
  binaries.select { |b| File.file?(b) }.flat_map { |b| swift_runtime_dep_names(b) }.uniq
end

# ASC's legacy expected set for one bundle: every /usr/lib/swift/lib*.dylib
# name any of its binaries reference (weak included — build 95's expected
# list contained weak-only refs) that exists in the GM toolchain's
# swift-5.0/<plat> dir. Deterministic; verified byte-for-byte against the
# build 95 ITMS-90429 rejection list.
def legacy_swift_expected_names(bundle_dir, platform_subdir)
  tc_dir = swift50_toolchain_dir(platform_subdir)
  UI.user_error!("Toolchain legacy Swift dir missing: #{tc_dir}") unless File.directory?(tc_dir)
  available = Dir.glob(File.join(tc_dir, "*.dylib")).map { |l| File.basename(l) }
  bundle_swift_ref_names(bundle_dir) & available
end

# ASC ITMS-90429/90427: every dylib listed in SwiftSupport/<platform>/ must
# also physically exist in that bundle's own Frameworks/ (Xcode 26 does not
# run "Copy Swift Standard Libraries" at deployment targets this high, even
# with ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES=YES, so we do it ourselves before
# export).
#
# ASC ITMS-90433: a straight copy of the toolchain dylib keeps Apple's own
# swift-5.0/<platform> signature, which does NOT chain to our app's signing
# identity — build 89 was rejected with "libswiftCore.dylib doesn't have the
# correct code signature" for exactly this. Real Xcode's swift-stdlib-tool
# always re-signs each embedded dylib with the *app's own* identity (same as
# any other Frameworks/ item); replicate that with `codesign`, preserving the
# original identifier/entitlements/flags so it still looks like
# com.apple.dt.runtime.<name> (see #<embed-swift-issue>). Never leave the
# Apple toolchain signature on an embedded copy.
def embed_swift_runtime_into_archive!(archive_path)
  require "open3"
  app = Dir.glob(File.join(archive_path, "Products", "Applications", "*.app")).first
  UI.user_error!("No archive Products/Applications/*.app in #{archive_path}") unless app

  sign_sha, = find_distribution_identity_sha
  UI.user_error!("No distribution identity to re-sign embedded Swift dylibs") unless sign_sha

  # #build95: embedding new files into Frameworks/ *after* `xcodebuild archive`
  # has already signed the bundle leaves the bundle's own signature/
  # CodeResources manifest unaware of them. Re-signing only each dylib (not
  # the bundle) was not enough — a later export produced an IPA with 5 of the
  # 15 embedded dylibs silently missing from Frameworks/ (ITMS-90429, build
  # 95), even though nothing in our own script touched them again. Re-sign
  # the *bundle itself* right after modifying its Frameworks/ so CodeResources
  # is regenerated to include the new files, same as Xcode's own
  # swift-stdlib-tool + embed phase would if it ran during the build. Nested
  # code must be (re-)signed before the bundle that embeds it, so watch
  # companions are processed before the outer iOS/tvOS/visionOS app.
  # Real Xcode-signed content in the archive (main executable, other
  # Frameworks) always carries a secure Apple timestamp ("Signed Time=…" in
  # `codesign -dvvv`). `--timestamp=none` here left every dylib we touch as
  # the only untimestamped signatures in an otherwise fully-timestamped App
  # Store binary — a plausible trigger for ASC's async validator to flag the
  # whole Swift-support picture as invalid. Use the default (secure,
  # network) timestamp so re-signed content matches everything else.
  resign_bundle = lambda do |bundle_dir|
    _, _, cs_st = Open3.capture3(
      "codesign", "--force", "--sign", sign_sha,
      "--preserve-metadata=identifier,entitlements,flags", bundle_dir
    )
    UI.user_error!("codesign failed for #{File.basename(bundle_dir)} after embedding Swift runtime") unless cs_st.success?
  end

  # Copy `names` from the toolchain swift-5.0/<plat> dir into the bundle's
  # Frameworks/ (re-signed with our identity, as Xcode's swift-stdlib-tool
  # would), then re-seal the bundle. Returns the names actually copied.
  embed_legacy_set = lambda do |bundle_dir, platform_subdir, names|
    if names.empty?
      UI.important("#{File.basename(bundle_dir)}: legacy Swift set empty (#{platform_subdir}) — nothing to embed")
      return []
    end
    tc_dir = swift50_toolchain_dir(platform_subdir)
    dest_dir = File.join(bundle_dir, "Frameworks")
    FileUtils.mkdir_p(dest_dir)
    names.sort.each do |name|
      src = File.join(tc_dir, name)
      UI.user_error!("#{name} missing from #{tc_dir}") unless File.file?(src)
      dest = File.join(dest_dir, name)
      FileUtils.cp(src, dest)
      _, _, cs_st = Open3.capture3(
        "codesign", "--force", "--sign", sign_sha,
        "--preserve-metadata=identifier,entitlements,flags", dest
      )
      UI.user_error!("codesign failed for embedded #{name}") unless cs_st.success?
    end
    UI.message("Embedded + re-signed #{names.size} legacy Swift dylib(s) into #{File.basename(bundle_dir)}/Frameworks (#{platform_subdir}): #{names.sort.join(", ")}")
    resign_bundle.call(bundle_dir)
    names
  end

  # Back-deployment path for watchless bundles (unchanged; selects nothing at
  # our current deployment targets — the accepted tvOS/visionOS shape).
  embed_backdeploy = lambda do |bundle_dir, platform_subdir|
    plist = File.join(bundle_dir, "Info.plist")
    exe, = Open3.capture2("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleExecutable", plist)
    exe_path = File.join(bundle_dir, exe.to_s.strip)
    return [] unless File.file?(exe_path)

    min_os, = Open3.capture2("/usr/libexec/PlistBuddy", "-c", "Print :MinimumOSVersion", plist)
    min_os_major = min_os.to_s.strip.split(".").first.to_i
    names = swift_runtime_dep_names(exe_path).select do |name|
      SWIFT_BACKDEPLOY_LIB_NAMES.include?(name) && swift_backdeploy_needed?(name, min_os_major, platform_subdir)
    end
    if names.empty?
      UI.message("#{File.basename(bundle_dir)}: no Swift back-deployment dylib needed at MinimumOSVersion=#{min_os_major} (#{platform_subdir}); leaving Frameworks/ untouched")
      return []
    end
    dest_dir = File.join(bundle_dir, "Frameworks")
    FileUtils.mkdir_p(dest_dir)
    copied = names.filter_map do |name|
      src = xcode_swift_lib_source(name, platform_subdir)
      unless src
        UI.important("#{name} not found in any Xcode toolchain swift-*/#{platform_subdir}; skipping")
        next nil
      end
      dest = File.join(dest_dir, name)
      FileUtils.cp(src, dest)
      _, _, cs_st = Open3.capture3(
        "codesign", "--force", "--sign", sign_sha,
        "--preserve-metadata=identifier,entitlements,flags", dest
      )
      UI.user_error!("codesign failed for embedded #{name}") unless cs_st.success?
      name
    end
    resign_bundle.call(bundle_dir) unless copied.empty?
    copied
  end

  dt_platform, = Open3.capture2("/usr/libexec/PlistBuddy", "-c", "Print :DTPlatformName", File.join(app, "Info.plist"))
  main_platform = case dt_platform.to_s.strip
                  when "appletvos" then "appletvos"
                  when "watchos" then "watchos"
                  else "iphoneos" # includes xros (visionOS reuses iphoneos SwiftSupport layout)
                  end

  watch_bundles = Dir.glob(File.join(app, "Watch", "*.app"))
  embedded = {}

  if watch_bundles.any?
    # #build119 legacy mode: watch-bearing package. Embed the full legacy
    # expected set per bundle AND assemble <archive>/SwiftSupport/<plat>/
    # with pristine Apple-signed toolchain originals so that
    # `xcodebuild -exportArchive` packages them the same way Organizer does
    # for a pre-ABI-stability archive. Nested (watch) bundle first so the
    # outer app's re-seal covers the updated companion.
    ss_root = File.join(archive_path, "SwiftSupport")
    watch_bundles.each do |watch_app|
      names = legacy_swift_expected_names(watch_app, "watchos")
      embedded["watchos"] = embed_legacy_set.call(watch_app, "watchos", names)
      ss_dest = File.join(ss_root, "watchos")
      FileUtils.mkdir_p(ss_dest)
      names.each { |n| FileUtils.cp(File.join(swift50_toolchain_dir("watchos"), n), File.join(ss_dest, n)) }
    end
    names = legacy_swift_expected_names(app, main_platform)
    embedded[main_platform] = embed_legacy_set.call(app, main_platform, names)
    ss_dest = File.join(ss_root, main_platform)
    FileUtils.mkdir_p(ss_dest)
    names.each { |n| FileUtils.cp(File.join(swift50_toolchain_dir(main_platform), n), File.join(ss_dest, n)) }
    UI.success("Archive SwiftSupport/ assembled: #{Dir.glob(File.join(ss_root, '*', '*.dylib')).size} Apple-signed dylib(s) across #{Dir.glob(File.join(ss_root, '*')).map { |d| File.basename(d) }.sort.join(', ')}")
  else
    embedded[main_platform] = embed_backdeploy.call(app, main_platform)
  end

  embedded
end

# Map IPA contents → SwiftSupport subdirs ASC expects.
def swift_support_platforms_for_ipa_dir(dir)
  require "open3"
  app = Dir.glob(File.join(dir, "Payload", "*.app")).first
  UI.user_error!("No Payload/*.app while synthesizing SwiftSupport") unless app
  plist = File.join(app, "Info.plist")
  platform, = Open3.capture2(
    "/usr/libexec/PlistBuddy", "-c", "Print :DTPlatformName", plist
  )
  platform = platform.to_s.strip
  platforms = case platform
              when "iphoneos" then ["iphoneos"]
              when "appletvos" then ["appletvos"]
              when "watchos" then ["watchos"]
              when "xros" then ["iphoneos"] # visionOS reuses iphoneos SwiftSupport layout
              else
                UI.important("Unknown DTPlatformName=#{platform.inspect}; defaulting SwiftSupport/iphoneos")
                ["iphoneos"]
              end
  # Companion watch content needs its own SwiftSupport/watchos slice.
  if Dir.glob(File.join(app, "Watch", "*.app")).any?
    platforms << "watchos" unless platforms.include?("watchos")
  end
  platforms
end

# If the IPA lacks SwiftSupport/: prefer the .xcarchive copy; else synthesize
# SwiftSupport/<platform> straight from the Xcode toolchain (never from
# Frameworks/ — embed_swift_runtime_into_archive! re-signs those with our own
# identity per ITMS-90433, but SwiftSupport/ must keep Apple's own toolchain
# signature) — but ONLY for the narrow, actually-needed back-deployment names
# `embed_swift_runtime_into_archive!` put in Frameworks/ (see
# `SWIFT_BACKDEPLOY_LIB_NAMES`/`swift_backdeploy_needed?`). #build104: this
# used to fall back to dumping the *entire* toolchain swift-5.0/<platform>
# overlay list into SwiftSupport/ whenever Frameworks/ had nothing matching —
# manufacturing SwiftSupport content no real Xcode 26 export at our
# deployment target would ever produce, and the most likely reason ASC kept
# rejecting builds 89-104 across every zip/signature variant tried. If no
# bundle needs any back-deployment dylib, leave the IPA exactly as exported —
# a WATCHLESS app at this deployment target legitimately ships with no
# SwiftSupport/ at all, and that is not an error. Watch-bearing archives
# always carry SwiftSupport/ now (#build119, legacy mode in
# embed_swift_runtime_into_archive!), so for them this either finds the
# exporter already propagated it (early return) or copies it from the
# archive here; assert_ipa_has_swift_support! hard-fails pre-upload if
# neither happened.
def inject_swift_support_from_archive!(ipa, archive_path)
  require "open3"
  listing, st = Open3.capture2("unzip", "-Z1", ipa)
  UI.user_error!("unzip -Z1 failed for #{ipa}") unless st.success?
  return if listing.lines.any? { |l| l.start_with?("SwiftSupport/") }

  archive_ss = File.join(archive_path, "SwiftSupport")
  Dir.mktmpdir("wawona-swift-support") do |dir|
    sh("unzip -q #{ipa.shellescape} -d #{dir.shellescape}")

    if File.directory?(archive_ss)
      UI.message("Injecting SwiftSupport/ from #{File.basename(archive_path)}…")
      FileUtils.cp_r(archive_ss, dir)
    else
      app = Dir.glob(File.join(dir, "Payload", "*.app")).first
      main_platform = swift_support_platforms_for_ipa_dir(dir).first
      bundles = { main_platform => app }
      Dir.glob(File.join(app, "Watch", "*.app")).each { |w| bundles["watchos"] = w }

      any_from_frameworks = false
      bundles.each do |plat, bundle_dir|
        fw_dir = File.join(bundle_dir, "Frameworks")
        names = File.directory?(fw_dir) ? Dir.glob(File.join(fw_dir, "libswift*.dylib")).map { |l| File.basename(l) } & SWIFT_BACKDEPLOY_LIB_NAMES : []
        next if names.empty?

        any_from_frameworks = true
        UI.message("Synthesizing SwiftSupport/#{plat} from #{names.size} back-deployment dylib(s) matching #{File.basename(bundle_dir)} Frameworks: #{names.sort.join(", ")}")
        dest = File.join(dir, "SwiftSupport", plat)
        FileUtils.mkdir_p(dest)
        names.each do |name|
          src = xcode_swift_lib_source(name, plat)
          next unless src

          FileUtils.cp(src, File.join(dest, name)) unless File.exist?(File.join(dest, name))
        end
      end

      unless any_from_frameworks
        UI.message("No Swift back-deployment dylibs needed by any bundle; leaving IPA without SwiftSupport/ (correct at this deployment target)")
        return
      end
    end

    ss = File.join(dir, "SwiftSupport")
    unless Dir.exist?(ss)
      UI.user_error!("Failed to assemble SwiftSupport/ for #{File.basename(ipa)}")
    end

    # Full clean rebuild from the fully-unzipped directory, replacing the
    # exportArchive-produced ipa outright. Appending SwiftSupport/ onto that
    # ipa in place (previous approach) round-tripped fine through our own
    # `unzip`/`unzip -Z1` checks locally, but ASC's own ingestion was
    # inconsistent on top of it: SwiftSupport/ missing entirely on one build
    # (ITMS-90426, build 93) and declared dylibs "not at the expected
    # Frameworks location" on another (ITMS-90429, build 95) even though a
    # fresh local re-extraction of the very same ipa showed them present.
    # Mixing an append from the system `zip` binary onto a zip produced by a
    # different tool (xcodebuild's own exporter) is exactly the kind of thing
    # that round-trips for lenient readers and not for stricter ones.
    # Rebuilding from scratch out of one fully-materialized directory (the
    # layout every working IPA+SwiftSupport recipe uses) avoids that entirely.
    # An earlier attempt at a full rebuild produced "altool OK, then silent
    # ASC discard" — but that was before the #138 CFBundleSupportedPlatforms
    # fix, which is a far more likely explanation for silent, error-free
    # rejection than the rebuild mechanism itself. -y preserves framework
    # version symlinks; -X drops extra file attributes.
    rebuilt = "#{ipa}.rebuilt"
    FileUtils.rm_f(rebuilt)
    sh("cd #{dir.shellescape} && zip -qryX #{rebuilt.shellescape} Payload SwiftSupport")
    FileUtils.mv(rebuilt, ipa)
  end
  UI.success("Ensured SwiftSupport/ in #{File.basename(ipa)}")
end

# Defense in depth for the ITMS-90429/90427/90426 family: verify, in the
# *final* ipa (after any rebuild), that every dylib name declared under
# SwiftSupport/<platform>/ is physically present in the matching bundle's own
# Frameworks/. This is exactly the invariant ASC's own binary validator
# checks; catching a mismatch here fails the build locally instead of
# discovering it days later via an App Store Connect rejection email (as
# happened for build 95: 15 dylibs embedded pre-export, only 10 survived
# into the exported ipa's Frameworks/, and nothing before this asserted the
# two matched).
def assert_swift_support_frameworks_parity!(ipa)
  require "open3"
  Dir.mktmpdir("wawona-swift-support-check") do |dir|
    sh("unzip -q #{ipa.shellescape} -d #{dir.shellescape}")
    ss_root = File.join(dir, "SwiftSupport")
    next unless Dir.exist?(ss_root)

    app = Dir.glob(File.join(dir, "Payload", "*.app")).first
    UI.user_error!("No Payload/*.app while verifying SwiftSupport/Frameworks parity") unless app
    dt_platform, = Open3.capture2("/usr/libexec/PlistBuddy", "-c", "Print :DTPlatformName", File.join(app, "Info.plist"))
    main_platform = case dt_platform.to_s.strip
                    when "appletvos" then "appletvos"
                    when "watchos" then "watchos"
                    else "iphoneos" # includes xros
                    end
    bundle_for_platform = { main_platform => app }
    Dir.glob(File.join(app, "Watch", "*.app")).each { |w| bundle_for_platform["watchos"] = w }

    missing = []
    Dir.glob(File.join(ss_root, "*")).each do |plat_dir|
      next unless File.directory?(plat_dir)

      plat = File.basename(plat_dir)
      bundle_dir = bundle_for_platform[plat]
      unless bundle_dir
        UI.important("SwiftSupport/#{plat} has no matching bundle in #{File.basename(ipa)}; skipping parity check")
        next
      end
      fw_dir = File.join(bundle_dir, "Frameworks")
      Dir.glob(File.join(plat_dir, "*.dylib")).each do |lib|
        name = File.basename(lib)
        missing << "#{plat}/#{name} (expected #{File.basename(bundle_dir)}/Frameworks/#{name})" unless File.file?(File.join(fw_dir, name))
      end
    end

    unless missing.empty?
      UI.user_error!(
        "#{File.basename(ipa)}: SwiftSupport/ declares dylibs missing from their bundle's " \
        "Frameworks/ (would be rejected as ITMS-90429/90427):\n  - #{missing.join("\n  - ")}"
      )
    end
  end
  UI.success("#{File.basename(ipa)}: SwiftSupport/ \u2194 Frameworks/ parity OK")
end

def wawona_version
  @wawona_version ||= begin
    raw = ENV["WAWONA_VERSION"]
    raw = File.read(File.expand_path("../VERSION", __dir__)).strip if raw.to_s.empty?
    raw.sub(/\A[vV]/, "")
  end
end

def wawona_build_number
  @wawona_build_number ||= ENV.fetch("WAWONA_BUILD_NUMBER") do
    ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
  end
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    is_key_content_base64: true
  )
end

def match_force?
  ENV["MATCH_FORCE"].to_s == "1"
end

def match_readonly?
  return false if match_force?
  return ENV["MATCH_READONLY"].to_s != "0" if ENV.key?("MATCH_READONLY")
  !!ENV["CI"]
end

# App targets use Wawona-iCloud.entitlements; App Store profiles must include
# those capabilities or xcodebuild fails at archive. `produce` has no api_key
# option — uses Apple ID session / portal cookies when APPLE_ID is set.
def ensure_icloud_app_id!(_api_key, app_id)
  unless ENV["APPLE_ID"].to_s.strip.empty?
    UI.message("Ensuring iCloud capability on App ID #{app_id}")
    produce(
      username: ENV.fetch("APPLE_ID"),
      app_identifier: app_id,
      skip_itc: true,
      enable_services: {
        icloud: "xcode5_compatible"
      }
    )
  else
    UI.important("APPLE_ID unset — skipping produce iCloud; App ID must already have iCloud enabled")
  end
rescue StandardError => e
  UI.important("produce iCloud for #{app_id}: #{e.message}")
end

def find_distribution_identity_sha
  require "open3"
  keychains = [
    File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"),
    File.expand_path("~/Library/Keychains/login.keychain-db")
  ].select { |p| File.file?(p) }

  scan = lambda do |out|
    m = out.match(/([0-9A-F]{40})\s+"(Apple Distribution[^"]*|iPhone Distribution[^"]*|iOS Distribution[^"]*)"/i)
    m && m[1]
  end

  keychains.each do |kc|
    out, = Open3.capture2("security", "find-identity", "-v", "-p", "codesigning", kc)
    sha = scan.call(out)
    return [sha, kc] if sha
  end
  out, = Open3.capture2("security", "find-identity", "-v", "-p", "codesigning")
  sha = scan.call(out)
  [sha, nil]
end

def assert_distribution_identity!
  sha, = find_distribution_identity_sha
  unless sha
    UI.user_error!(
      "No Apple/iOS Distribution identity in keychain after match. " \
      "Check MATCH_* secrets and aspauldingcode/apple-signing certs."
    )
  end
  UI.message("Distribution identity present (#{sha[0, 8]}…)")
  sha
end

def install_testflight_profiles!(api_key)
  # match 2.232.x platforms: ios, tvos only. visionOS + watchOS use ios with their bundle IDs.
  # Install ios last for the main bundle id so MATCH_PROVISIONING_PROFILE_MAPPING
  # keeps the iOS App Store profile (tvos match would otherwise overwrite it).
  readonly = match_readonly?
  force = match_force?
  UI.message("match readonly=#{readonly} force=#{force}")

  ensure_icloud_app_id!(api_key, MAIN_BUNDLE_ID) unless readonly

  [
    ["tvos", MAIN_BUNDLE_ID],
    ["ios", WATCH_BUNDLE_ID],
    ["ios", MAIN_BUNDLE_ID]
  ].each do |platform, app_id|
    match(
      type: "appstore",
      readonly: readonly,
      force: force,
      platform: platform,
      app_identifier: app_id,
      api_key: api_key
    )
  end
  assert_distribution_identity!
end

def ensure_asc_platform_version!(api_key, platform, app_id = MAIN_BUNDLE_ID)
  UI.message("Ensuring App Store Connect version #{wawona_version} (#{platform}) for #{app_id}")
  deliver(
    api_key: api_key,
    app_identifier: app_id,
    platform: platform,
    app_version: wawona_version,
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: true,
    force: true,
    run_precheck_before_submit: false
  )
end

def ensure_all_asc_versions!(api_key)
  [
    ["ios", MAIN_BUNDLE_ID],
    ["appletvos", MAIN_BUNDLE_ID],
    ["xros", MAIN_BUNDLE_ID]
  ].each do |platform, app_id|
    ensure_asc_platform_version!(api_key, platform, app_id)
  end
end

# Fastlane's FastFile#sh only forwards log/step_name/error_callback from a
# trailing options hash — `env:` is silently dropped. Pass env as Open3's
# leading Hash (merged with ENV so PATH/HOME/NIX_* survive).
def nix_sh(command, extra_env)
  sh(ENV.to_h.merge(extra_env.transform_keys(&:to_s)), command, log: true)
end

def nix_impure_build_cmd(attr)
  "nix build .##{attr} --impure --option sandbox false " \
    "--option build-users-group \"\" " \
    "--print-out-paths --print-build-logs"
end

def ensure_xcodegen!
  project = File.expand_path("../Wawona.xcodeproj", __dir__)
  if ENV["WAWONA_SKIP_XCODEGEN"].to_s == "1" && Dir.exist?(project)
    UI.message("Skipping xcodegen (WAWONA_SKIP_XCODEGEN=1)")
    return
  end
  UI.message("Generating Xcode project (nix run .#xcodegen)...")
  sh("nix", "run", ".#xcodegen")
  UI.user_error!("Wawona.xcodeproj missing after xcodegen") unless Dir.exist?(project)
end

# nix develop exports CC/CXX/LD/NIX_LDFLAGS and clang-wrapper on PATH;
# xcodebuild then fails Ld with "unknown options: -Xlinker -dynamiclib".
# Prefer Apple tools and clear nix compiler env before gym.
def prefer_xcode_toolchain!
  developer_dir = ENV["DEVELOPER_DIR"].to_s
  developer_dir = `xcode-select -p`.strip if developer_dir.empty?
  drop = %w[
    clang-wrapper cctools binutils-darwin ld64-wrapper
    ccache-links compiler-rt
  ]
  filtered = ENV.fetch("PATH", "").split(":").reject do |p|
    drop.any? { |frag| p.include?(frag) }
  end
  head = []
  head << File.join(developer_dir, "usr/bin") unless developer_dir.empty?
  head.concat(%w[/usr/bin /bin /usr/sbin /sbin])
  ENV["PATH"] = (head + filtered).uniq.join(":")

  %w[
    CC CXX CPP LD AR AS NM RANLIB STRIP OBJCOPY OBJDUMP
    NIX_CC NIX_CFLAGS_COMPILE NIX_CFLAGS_LINK NIX_LDFLAGS
    NIX_LDFLAGS_FOR_TARGET MACOSX_DEPLOYMENT_TARGET
    DEVELOPER_DIR_FOR_BUILD SDKROOT
  ].each { |k| ENV.delete(k) }

  ENV["DEVELOPER_DIR"] = developer_dir unless developer_dir.empty?
  ENV["TOOLCHAINS"] ||= "com.apple.dt.toolchain.XcodeDefault"
  UI.message("Xcode toolchain preferred (#{developer_dir}); cleared nix CC/LD env")
  delete_metal_toolchain_component!
end

# #build110: build 104 shipped a full (but illegitimate) SwiftSupport/ and
# was rejected with ITMS-90426 "folder is missing"; build 110 shipped none
# at all (correct per SWIFT_BACKDEPLOY_LIB_NAMES gating — no back-deploy
# shim is needed at our deployment target) and got the *identical* rejection
# text. That means ASC's validator does not derive its own "should this
# binary have SwiftSupport" expectation from our reasoning about deployment
# targets — it expects Xcode's *own* archive step to have produced one.
# Xcode's swift-stdlib-tool never wrote SwiftSupport/ into any of our
# .xcarchives in the first place (inject_swift_support_from_archive! never
# once logged "Injecting … from <archive>", only its own fallback
# synthesis) — a known, GitHub-confirmed Xcode 26 regression: the
# `MetalToolchain` component (present by default on `macos-26` runner
# images) rewrites toolchain search paths so swift-stdlib-tool can no longer
# find Swift compatibility libraries during archive, and it silently skips
# writing SwiftSupport/ instead of erroring
# (github.com/actions/runner-images/issues/13135). `TOOLCHAINS=` alone does
# not fix this — the component itself must be removed from the runner's
# Xcode install. Idempotent: does nothing if already uninstalled (e.g. on a
# local dev machine that never downloaded it).
def delete_metal_toolchain_component!
  require "open3"
  out, _, st = Open3.capture3("xcodebuild", "-showComponent", "MetalToolchain")
  return unless st.success?
  return if out.include?("uninstalled")

  UI.message("Deleting installed MetalToolchain component (Xcode 26 swift-stdlib-tool search-path regression, actions/runner-images#13135)…")
  _, err, del_st = Open3.capture3("xcodebuild", "-deleteComponent", "MetalToolchain")
  UI.important("xcodebuild -deleteComponent MetalToolchain failed (continuing): #{err}") unless del_st.success?
end

def gym_output_dir
  @gym_output_dir ||= begin
    dir = ENV.fetch("WAWONA_GYM_OUTPUT") do
      File.join(Dir.tmpdir, "wawona-gym-#{Process.pid}")
    end
    FileUtils.mkdir_p(dir)
    dir
  end
end

# Nix owns xcodegen + Rust prebuild (Xcode build phase -> xcode-prebuild.sh).
# Fastlane owns match keychain, gym archive/export, and TestFlight upload.
#
# Do NOT pass PROVISIONING_PROFILE_SPECIFIER via global xcargs — it applies to
# every target (WawonaModel / WawonaUIContracts frameworks cannot take profiles).
def gym_ipa(target)
  team_id = ENV.fetch("TEAM_ID")
  profile = target[:profile_name]
  identity = ENV.fetch("WAWONA_CODE_SIGN_IDENTITY", "Apple Distribution")
  project = File.expand_path("../Wawona.xcodeproj", __dir__)

  update_code_signing_settings(
    path: project,
    use_automatic_signing: false,
    team_id: team_id,
    targets: [target[:scheme]],
    code_sign_identity: identity,
    profile_name: profile,
    bundle_identifier: target[:bundle_id]
  )

  provisioning_profiles = {
    target[:bundle_id] => profile
  }

  # Companion watch rides inside the iOS IPA (#136). Sign it and map its
  # App Store profile into exportOptions — otherwise export drops/fails the embed.
  if target[:scheme] == "Wawona-iOS" && ENV["WAWONA_SKIP_WATCH"].to_s != "1"
    update_code_signing_settings(
      path: project,
      use_automatic_signing: false,
      team_id: team_id,
      targets: ["Wawona-watchOS"],
      code_sign_identity: identity,
      profile_name: WATCH_PROFILE_NAME,
      bundle_identifier: WATCH_BUNDLE_ID
    )
    provisioning_profiles[WATCH_BUNDLE_ID] = WATCH_PROFILE_NAME
  end

  xcargs = [
    "DEVELOPMENT_TEAM=#{team_id}",
    "CURRENT_PROJECT_VERSION=#{wawona_build_number}",
    "MARKETING_VERSION=#{wawona_version}"
    # ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES is a per-target project setting
    # (xcodegen.nix: YES on Wawona-iOS/Wawona-watchOS app targets, NO on
    # WawonaModel/WawonaUIContracts framework targets). A global xcarg here
    # would force YES onto the framework targets too and reproduce ASC
    # ITMS-90429/90427 (Frameworks/libswift* only expected on app targets).
  ].join(" ")

  UI.message(
    "gym #{target[:scheme]} (version #{wawona_version}, build #{wawona_build_number}, " \
    "destination=#{target[:destination]})"
  )

  # Gym 2.232 regenerates ExportOptions and forces method=app-store even when
  # given a custom plist path (CI log: "Generated plist … method: app-store").
  # Archive with gym, then exportArchive ourselves with app-store-connect.
  export_plist = File.join(gym_output_dir, "ExportOptions-#{target[:scheme]}.plist")
  profile_xml = provisioning_profiles.map do |bid, name|
    "\t\t<key>#{bid}</key>\n\t\t<string>#{name}</string>"
  end.join("\n")
  File.write(export_plist, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>method</key>
    \t<string>app-store-connect</string>
    \t<key>destination</key>
    \t<string>export</string>
    \t<key>signingStyle</key>
    \t<string>manual</string>
    \t<key>signingCertificate</key>
    \t<string>#{identity}</string>
    \t<key>teamID</key>
    \t<string>#{team_id}</string>
    \t<key>uploadSymbols</key>
    \t<true/>
    \t<key>manageAppVersionAndBuildNumber</key>
    \t<false/>
    \t<key>provisioningProfiles</key>
    \t<dict>
    #{profile_xml}
    \t</dict>
    </dict>
    </plist>
  PLIST

  # Avoid stale XCODEBUILD_ARCHIVE from a prior scheme (shared gym_output_dir).
  lane_context[SharedValues::XCODEBUILD_ARCHIVE] = nil

  build_app(
    project: project,
    scheme: target[:scheme],
    clean: true,
    silent: false,
    destination: target[:destination],
    skip_package_ipa: true,
    export_method: "app-store",
    xcargs: xcargs,
    output_directory: gym_output_dir,
    output_name: "#{target[:scheme]}-#{wawona_version}-#{wawona_build_number}",
    skip_profile_detection: true,
    build_path: File.join(gym_output_dir, "build-#{target[:scheme]}"),
    derived_data_path: File.join(gym_output_dir, "DerivedData-#{target[:scheme]}")
  )

  archive = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
  UI.user_error!("gym produced no .xcarchive") unless archive && File.directory?(archive)
  # Shared bundle id across iOS/tvOS/visionOS: confirm archive identity after gym so a
  # stale XCODEBUILD_ARCHIVE cannot feed the wrong ExportOptions profile set.
  require "open3"
  app_props = File.join(archive, "Info.plist")
  if File.file?(app_props)
    bundle_id, = Open3.capture2(
      "/usr/libexec/PlistBuddy", "-c",
      "Print :ApplicationProperties:CFBundleIdentifier", app_props
    )
    UI.message("Archive #{File.basename(archive)} bundle=#{bundle_id.to_s.strip}")
  end

  embed_swift_runtime_into_archive!(archive)

  export_dir = File.join(gym_output_dir, "export-#{target[:scheme]}")
  FileUtils.rm_rf(export_dir)
  FileUtils.mkdir_p(export_dir)
  UI.message("exportArchive method=app-store-connect → #{export_dir}")
  # #138: exportArchive for Wawona-tvOS/-visionOS reproducibly failed with
  # "Provisioning profile ... has platform 'tvOS', which does not match the
  # current platform 'iOS'" — including in a single-scheme, single-process
  # `debug_export` run, which ruled out cross-scheme ENV leakage in this Ruby
  # process (the original theory here). Root cause, confirmed by inspecting a
  # local .xcarchive's Products/Applications/Wawona.app/Info.plist directly:
  # src/resources/app-bundle/Info.plist is shared verbatim
  # (GENERATE_INFOPLIST_FILE=NO) across every Apple app target and hardcodes
  # CFBundleSupportedPlatforms=[iPhoneOS] + LSRequiresIPhoneOS=true.
  # `xcodebuild -exportArchive` reads CFBundleSupportedPlatforms — NOT
  # DTPlatformName/DTSDKName, which were both correctly appletvos/xros in the
  # affected archives — to decide "current platform", so it rejected the
  # (correctly platform-scoped) provisioning profile. Fixed at the source in
  # `dependencies/generators/xcodegen.nix` (`stripIOSOnlyInfoPlistKeysPhase`
  # on the tvOS/macOS/visionOS app targets); verified locally end-to-end for
  # both Wawona-tvOS and Wawona-visionOS via `fastlane ios debug_export`.
  # Keep exporting in a minimal, explicit environment regardless — it is a
  # reasonable defensive practice for `xcodebuild`/gym-internal ENV state
  # even though it was not this bug's actual cause.
  clean_env = {
    "PATH" => ENV["PATH"],
    "HOME" => ENV["HOME"],
    "USER" => ENV["USER"],
    "TMPDIR" => ENV["TMPDIR"],
    "DEVELOPER_DIR" => ENV["DEVELOPER_DIR"]
  }.compact
  out, err, st = Open3.capture3(
    clean_env,
    "/usr/bin/xcrun", "xcodebuild",
    "-exportArchive",
    "-archivePath", archive,
    "-exportOptionsPlist", export_plist,
    "-exportPath", export_dir,
    unsetenv_others: true
  )
  UI.message(out) unless out.to_s.strip.empty?
  unless st.success?
    UI.error(err) unless err.to_s.strip.empty?
    UI.user_error!("xcodebuild -exportArchive failed (exit #{st.exitstatus}) for #{target[:scheme]}")
  end
  UI.message(err) unless err.to_s.strip.empty?

  exported = Dir.glob(File.join(export_dir, "*.ipa")).first
  UI.user_error!("exportArchive produced no IPA in #{export_dir}") unless exported
  final_ipa = File.join(
    gym_output_dir,
    "#{target[:scheme]}-#{wawona_version}-#{wawona_build_number}.ipa"
  )
  FileUtils.mv(exported, final_ipa)
  inject_swift_support_from_archive!(final_ipa, archive)
  lane_context[SharedValues::IPA_OUTPUT_PATH] = final_ipa
  final_ipa
end

def nix_aab_path
  env = {
    # BASE64 is required for sandboxed/daemon builds; path alone is unreadable.
    "ANDROID_KEYSTORE_BASE64" => ENV.fetch("ANDROID_KEYSTORE_BASE64"),
    "ANDROID_KEYSTORE_PASSWORD" => ENV.fetch("ANDROID_KEYSTORE_PASSWORD"),
    "ANDROID_KEY_ALIAS" => ENV.fetch("ANDROID_KEY_ALIAS"),
    "ANDROID_KEY_PASSWORD" => ENV.fetch("ANDROID_KEY_PASSWORD"),
    "WAWONA_VERSION" => wawona_version,
    "WAWONA_BUILD_NUMBER" => wawona_build_number
  }
  out = nix_sh(nix_impure_build_cmd("wawona-android-aab"), env).strip.split("\n").last
  aab = Dir.glob(File.join(out, "**", "*.aab")).first
  UI.user_error!("No AAB found in #{out}") unless aab
  aab
end

platform :ios do
  desc "Archive+export one scheme only, no upload (fast local repro for export bugs, e.g. #138)"
  lane :debug_export do
    validate_env
    setup_ci if ENV["CI"]
    ensure_xcodegen!
    prefer_xcode_toolchain!
    api_key = asc_api_key
    install_testflight_profiles!(api_key)
    scheme = ENV.fetch("WAWONA_DEBUG_SCHEME", "Wawona-tvOS")
    target = APPLE_BETA_TARGETS.find { |t| t[:scheme] == scheme }
    UI.user_error!("#{scheme} missing from APPLE_BETA_TARGETS") unless target
    ipa = gym_ipa(target)
    assert_ipa_no_private_progname!(ipa)
    assert_ipa_has_swift_support!(ipa)
    assert_ipa_has_watch_companion!(ipa) if scheme == "Wawona-iOS"
    # Stage for CI artifact upload so the exact uploaded-shaped ipa can be
    # inspected/validated locally (e.g. `xcrun altool --validate-app`)
    # without waiting hours for an async ASC rejection email.
    out = File.expand_path("../dist/#{scheme}-#{wawona_version}-#{wawona_build_number}.ipa", __dir__)
    FileUtils.mkdir_p(File.dirname(out))
    FileUtils.cp(ipa, out)
    UI.success("debug_export built #{ipa} (no upload); staged at #{out}")
  end

  desc "Upload universal iOS, Apple TV, and Apple Vision Pro to TestFlight"
  lane :beta do
    validate_env
    setup_ci if ENV["CI"]
    ensure_xcodegen!
    prefer_xcode_toolchain!
    api_key = asc_api_key
    install_testflight_profiles!(api_key)
    ensure_all_asc_versions!(api_key)

    apple_beta_targets.each do |target|
      ipa = gym_ipa(target)
      assert_ipa_no_private_progname!(ipa)
      assert_ipa_has_swift_support!(ipa)
      assert_ipa_has_watch_companion!(ipa) if target[:scheme] == "Wawona-iOS"
      upload_to_testflight(
        **testflight_upload_options(api_key, target),
        ipa: ipa
      )
      if beta_testflight_groups.any?
        UI.success(
          "Uploaded and distributed #{target[:name]} #{wawona_version} (#{wawona_build_number}) " \
          "to TestFlight groups: #{beta_testflight_groups.join(', ')}"
        )
      else
        UI.success("Uploaded #{target[:name]} #{wawona_version} (#{wawona_build_number}) to TestFlight")
      end
    end
  end

  desc "Stage universal iOS IPA for GitHub Release (no TestFlight upload)"
  lane :github_ipa do
    validate_env
    setup_ci if ENV["CI"]
    ensure_xcodegen!
    prefer_xcode_toolchain!
    api_key = asc_api_key
    install_testflight_profiles!(api_key)

    target = apple_beta_targets.find { |t| t[:scheme] == "Wawona-iOS" } ||
             APPLE_BETA_TARGETS.find { |t| t[:scheme] == "Wawona-iOS" }
    UI.user_error!("Wawona-iOS missing from APPLE_BETA_TARGETS") unless target

    ipa = gym_ipa(target)
    assert_ipa_no_private_progname!(ipa)
    assert_ipa_has_swift_support!(ipa)
    assert_ipa_has_watch_companion!(ipa)
    # Fastlane's cwd is the fastlane/ directory; stage at repo-root dist/.
    out = File.expand_path("../dist/Wawona-#{wawona_version}-iOS.ipa", __dir__)
    FileUtils.mkdir_p(File.dirname(out))
    FileUtils.cp(ipa, out)
    UI.success("Staged #{out}")
  end

  desc "Upload an existing iOS IPA (with watch companion) to TestFlight"
  lane :upload_ios_ipa do
    validate_env
    setup_ci if ENV["CI"]
    api_key = asc_api_key
    target = APPLE_BETA_TARGETS.find { |t| t[:scheme] == "Wawona-iOS" }
    UI.user_error!("Wawona-iOS missing from APPLE_BETA_TARGETS") unless target
    ipa = ENV["WAWONA_IPA"].to_s
    if ipa.empty?
      ipa = File.expand_path("../dist/Wawona-#{wawona_version}-iOS.ipa", __dir__)
    end
    UI.user_error!("IPA not found: #{ipa}") unless File.file?(ipa)
    assert_ipa_has_watch_companion!(ipa)
    upload_to_testflight(**testflight_upload_options(api_key, target), ipa: ipa)
    UI.success("Uploaded #{File.basename(ipa)} to TestFlight")
  end

  desc "Submit iOS builds for App Store review"
  lane :release do
    validate_env
    setup_ci if ENV["CI"]
    ensure_xcodegen!
    prefer_xcode_toolchain!
    api_key = asc_api_key
    install_testflight_profiles!(api_key)
    ensure_all_asc_versions!(api_key)

    apple_beta_targets.each do |target|
      ipa = gym_ipa(target)
      assert_ipa_no_private_progname!(ipa)
      assert_ipa_has_swift_support!(ipa)
      assert_ipa_has_watch_companion!(ipa) if target[:scheme] == "Wawona-iOS"
      deliver(
        api_key: api_key,
        app_identifier: target[:bundle_id],
        platform: target[:app_platform],
        ipa: ipa,
        submit_for_review: true,
        force: true,
        skip_screenshots: true,
        skip_metadata: true,
        run_precheck_before_submit: false
      )
      UI.success("Submitted #{target[:name]} #{wawona_version} (#{wawona_build_number}) for App Store review")
    end
  end
end

platform :android do
  desc "Upload Android AAB to Play internal track"
  lane :beta do
    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.aspauldingcode.wawona"),
      track: "internal",
      aab: nix_aab_path,
      json_key_data: ENV.fetch("PLAY_STORE_JSON_KEY"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

desc "Upload Apple + Android beta builds"
lane :beta do
  ios_beta
  android_beta
end
