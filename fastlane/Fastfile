# frozen_string_literal: true

require "fileutils"

default_platform(:ios)

# --- Common helpers ---

def check_env(vars)
  missing = vars.select { |v| ENV[v].nil? || ENV[v].to_s.empty? }
  UI.user_error!("Missing environment variables: #{missing.join(', ')}. See .release-secrets.env.template") unless missing.empty?
end

desc "Sync version from VERSION file to Cargo.toml and Android build.gradle.kts"
lane :sync_version do
  version = wawona_version
  UI.message("Syncing version #{version} to platform manifests...")

  cargo_toml = File.expand_path("../Cargo.toml", __dir__)
  cargo_content = File.read(cargo_toml)
  File.write(cargo_toml, cargo_content.gsub(/^version = ".*"$/, "version = \"#{version}\""))

  gradle_path = File.expand_path("../android/app/build.gradle.kts", __dir__)
  if File.exist?(gradle_path)
    gradle_content = File.read(gradle_path)
    File.write(gradle_path, gradle_content.gsub(/versionName = ".*"$/, "versionName = \"#{version}\""))
  end

  UI.success("Versions synced to #{version}")
end

desc "Verify release environment (Apple credentials)"
lane :validate_env do
  check_env(%w[
    TEAM_ID
    APP_STORE_CONNECT_KEY_ID
    APP_STORE_CONNECT_ISSUER_ID
    APP_STORE_CONNECT_API_KEY
  ])
  UI.success("Environment validated")
end

desc "Enable iCloud on App IDs and force-regenerate App Store match profiles"
lane :regenerate_signing do
  validate_env
  setup_ci if ENV["CI"]
  ENV["MATCH_FORCE"] = "1"
  ENV["MATCH_READONLY"] = "0"
  api_key = asc_api_key
  install_testflight_profiles!(api_key)
  UI.success("App Store profiles regenerated (iCloud-capable). apple-signing repo updated.")
end

# TestFlight targets (macOS is intentionally excluded — not distributed via TestFlight).
# profile_name must match fastlane match App Store profile naming.
APPLE_BETA_TARGETS = [
  { ipa: "wawona-ios-ipa", name: "iPhone (iOS)", app_platform: "ios", bundle_id: "com.aspauldingcode.Wawona", profile_name: "match AppStore com.aspauldingcode.Wawona" },
  { ipa: "wawona-ipados-ipa", name: "iPad (iPadOS)", app_platform: "ios", bundle_id: "com.aspauldingcode.Wawona", profile_name: "match AppStore com.aspauldingcode.Wawona" },
  { ipa: "wawona-tvos-ipa", name: "Apple TV (tvOS)", app_platform: "appletvos", bundle_id: "com.aspauldingcode.Wawona", profile_name: "match AppStore com.aspauldingcode.Wawona tvos" },
  { ipa: "wawona-visionos-ipa", name: "Apple Vision Pro (visionOS)", app_platform: "xros", bundle_id: "com.aspauldingcode.Wawona", profile_name: "match AppStore com.aspauldingcode.Wawona" },
  { ipa: "wawona-watchos-ipa", name: "Apple Watch (watchOS)", app_platform: "ios", bundle_id: "com.aspauldingcode.Wawona.watch", profile_name: "match AppStore com.aspauldingcode.Wawona.watch" }
].freeze

MAIN_BUNDLE_ID = "com.aspauldingcode.Wawona"
WATCH_BUNDLE_ID = "com.aspauldingcode.Wawona.watch"
BETA_FEEDBACK_EMAIL = ENV.fetch("BETA_FEEDBACK_EMAIL", "aspauldingcode@gmail.com")

def beta_testflight_groups
  ENV.fetch("BETA_TESTFLIGHT_GROUPS", "")
     .split(",")
     .map(&:strip)
     .reject(&:empty?)
end

def testflight_upload_options(api_key, target)
  opts = {
    api_key: api_key,
    app_identifier: target[:bundle_id],
    app_platform: target[:app_platform],
    beta_app_feedback_email: BETA_FEEDBACK_EMAIL,
    changelog: "Wawona #{wawona_version} (#{wawona_build_number}) beta",
    skip_waiting_for_build_processing: true
  }
  groups = beta_testflight_groups
  if groups.any?
    opts[:groups] = groups
    opts[:distribute_external] = true
    opts[:notify_external_testers] = true
    opts[:skip_waiting_for_build_processing] = false
  end
  opts
end

def wawona_version
  @wawona_version ||= begin
    raw = ENV["WAWONA_VERSION"]
    raw = File.read(File.expand_path("../VERSION", __dir__)).strip if raw.to_s.empty?
    raw.sub(/\A[vV]/, "")
  end
end

def wawona_build_number
  @wawona_build_number ||= ENV.fetch("WAWONA_BUILD_NUMBER") do
    ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
  end
end

def nix_build_env
  {
    "WAWONA_VERSION" => wawona_version,
    "WAWONA_BUILD_NUMBER" => wawona_build_number,
    "TEAM_ID" => ENV.fetch("TEAM_ID")
  }
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    is_key_content_base64: true
  )
end

def match_force?
  ENV["MATCH_FORCE"].to_s == "1"
end

def match_readonly?
  return false if match_force?
  return ENV["MATCH_READONLY"].to_s != "0" if ENV.key?("MATCH_READONLY")
  !!ENV["CI"]
end

# App targets use Wawona-iCloud.entitlements; App Store profiles must include
# those capabilities or xcodebuild fails at archive. `produce` has no api_key
# option — uses Apple ID session / portal cookies when APPLE_ID is set.
def ensure_icloud_app_id!(_api_key, app_id)
  unless ENV["APPLE_ID"].to_s.strip.empty?
    UI.message("Ensuring iCloud capability on App ID #{app_id}")
    produce(
      username: ENV.fetch("APPLE_ID"),
      app_identifier: app_id,
      skip_itc: true,
      enable_services: {
        icloud: "xcode5_compatible"
      }
    )
  else
    UI.important("APPLE_ID unset — skipping produce iCloud; App ID must already have iCloud enabled")
  end
rescue StandardError => e
  UI.important("produce iCloud for #{app_id}: #{e.message}")
end

def find_distribution_identity_sha
  require "open3"
  keychains = [
    File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"),
    File.expand_path("~/Library/Keychains/login.keychain-db")
  ].select { |p| File.file?(p) }

  scan = lambda do |out|
    m = out.match(/([0-9A-F]{40})\s+"(Apple Distribution[^"]*|iPhone Distribution[^"]*|iOS Distribution[^"]*)"/i)
    m && m[1]
  end

  keychains.each do |kc|
    out, = Open3.capture2("security", "find-identity", "-v", "-p", "codesigning", kc)
    sha = scan.call(out)
    return [sha, kc] if sha
  end
  out, = Open3.capture2("security", "find-identity", "-v", "-p", "codesigning")
  sha = scan.call(out)
  [sha, nil]
end

def assert_distribution_identity!
  sha, = find_distribution_identity_sha
  unless sha
    UI.user_error!(
      "No Apple/iOS Distribution identity in keychain after match. " \
      "Check MATCH_* secrets and aspauldingcode/apple-signing certs."
    )
  end
  UI.message("Distribution identity present (#{sha[0, 8]}…)")
  sha
end

# Export match Distribution identity into a private keychain under a host
# temp dir (/var/folders or /tmp) — never under /nix/var/nix/builds (security
# cannot use keychains there). Paths only are passed into nix; never log
# password or P12 bytes.
def stage_distribution_cert_for_nix!
  require "securerandom"
  require "open3"
  require "tmpdir"
  require "fileutils"

  sha, source_kc = find_distribution_identity_sha
  UI.user_error!("No Apple Distribution identity to stage for nix IPA") unless sha

  dir = Dir.mktmpdir("wawona-dist-")
  p12_path = File.join(dir, "dist.p12")
  pass_path = File.join(dir, "pass")
  kc_path = File.join(dir, "signing.keychain-db")
  pass = SecureRandom.hex(32)
  File.write(pass_path, pass)
  File.chmod(0o600, pass_path)

  if source_kc
    # setup_ci / match use an empty keychain password; allow headless export.
    Open3.capture2("security", "unlock-keychain", "-p", "", source_kc)
    Open3.capture3(
      "security", "set-key-partition-list",
      "-S", "apple-tool:,apple:,codesign:,security:",
      "-s", "-k", "", source_kc
    )
  end

  args = ["security", "export", "-t", "identities", "-f", "pkcs12", "-P", pass, "-o", p12_path]
  args += ["-k", source_kc] if source_kc
  _stdout, stderr, status = Open3.capture3(*args)
  unless status.success? && File.size?(p12_path)
    FileUtils.remove_entry(dir, true)
    detail = stderr.to_s.strip.empty? ? "security export failed" : "security export failed (see runner keychain ACL)"
    UI.user_error!("Failed to stage Distribution cert for nix: #{detail}")
  end
  File.chmod(0o600, p12_path)

  # Build keychain on the host filesystem (absolute path). macOS security
  # rejects keychains under the nix build TMPDIR.
  Open3.capture2("security", "delete-keychain", kc_path)
  _o, _c_err, c_st = Open3.capture3("security", "create-keychain", "-p", pass, kc_path)
  unless c_st.success? && File.size?(kc_path)
    FileUtils.remove_entry(dir, true)
    UI.user_error!("Failed to create signing keychain for nix IPA")
  end
  Open3.capture3("security", "set-keychain-settings", "-t", "3600", "-u", kc_path)
  Open3.capture3("security", "unlock-keychain", "-p", pass, kc_path)
  _i, _i_err, i_st = Open3.capture3(
    "security", "import", p12_path, "-k", kc_path, "-P", pass,
    "-A", "-T", "/usr/bin/codesign", "-T", "/usr/bin/security", "-T", "/usr/bin/xcodebuild"
  )
  unless i_st.success?
    FileUtils.remove_entry(dir, true)
    UI.user_error!("Failed to import Distribution cert into signing keychain")
  end
  Open3.capture3(
    "security", "set-key-partition-list",
    "-S", "apple-tool:,apple:,codesign:",
    "-s", "-k", pass, kc_path
  )
  FileUtils.rm_f(p12_path)

  out, = Open3.capture2("security", "find-identity", "-v", "-p", "codesigning", kc_path)
  unless out.match?(/Apple Distribution|iPhone Distribution|iOS Distribution/i)
    FileUtils.remove_entry(dir, true)
    UI.user_error!("Signing keychain has no Distribution identity after import")
  end

  ENV["WAWONA_DIST_KEYCHAIN"] = kc_path
  ENV["WAWONA_DIST_P12_PASS_FILE"] = pass_path
  ENV["WAWONA_DIST_SIGN_DIR"] = dir
  ENV["WAWONA_CODE_SIGN_IDENTITY"] = sha
  UI.message("Staged Distribution keychain for nix IPA (#{sha[0, 8]}…)")
end

def cleanup_staged_distribution_cert!
  kc = ENV.delete("WAWONA_DIST_KEYCHAIN")
  dir = ENV.delete("WAWONA_DIST_SIGN_DIR")
  ENV.delete("WAWONA_DIST_P12_FILE")
  ENV.delete("WAWONA_DIST_P12_PASS_FILE")
  if kc && File.exist?(kc)
    require "open3"
    Open3.capture2("security", "delete-keychain", kc)
  end
  FileUtils.remove_entry(dir, true) if dir && File.directory?(dir)
rescue StandardError
  # best-effort cleanup
end

def install_testflight_profiles!(api_key)
  # match 2.232.x platforms: ios, tvos only. visionOS + watchOS use ios with their bundle IDs.
  # Install ios last for the main bundle id so MATCH_PROVISIONING_PROFILE_MAPPING
  # keeps the iOS App Store profile (tvos match would otherwise overwrite it).
  readonly = match_readonly?
  force = match_force?
  UI.message("match readonly=#{readonly} force=#{force}")

  # Main iOS App ID needs iCloud before App Store profile regeneration.
  ensure_icloud_app_id!(api_key, MAIN_BUNDLE_ID) unless readonly

  [
    ["tvos", MAIN_BUNDLE_ID],
    ["ios", WATCH_BUNDLE_ID],
    ["ios", MAIN_BUNDLE_ID]
  ].each do |platform, app_id|
    match(
      type: "appstore",
      readonly: readonly,
      force: force,
      platform: platform,
      app_identifier: app_id,
      api_key: api_key
    )
  end
  assert_distribution_identity!
  stage_distribution_cert_for_nix!
end

def ensure_asc_platform_version!(api_key, platform, app_id = MAIN_BUNDLE_ID)
  UI.message("Ensuring App Store Connect version #{wawona_version} (#{platform}) for #{app_id}")
  deliver(
    api_key: api_key,
    app_identifier: app_id,
    platform: platform,
    app_version: wawona_version,
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: true,
    force: true,
    run_precheck_before_submit: false
  )
end

def ensure_all_asc_versions!(api_key)
  # iOS already at 0.2.4 in ASC; tvOS/visionOS default to 1.0 until we create the real version row.
  [
    ["ios", MAIN_BUNDLE_ID],
    ["appletvos", MAIN_BUNDLE_ID],
    ["xros", MAIN_BUNDLE_ID]
  ].each do |platform, app_id|
    ensure_asc_platform_version!(api_key, platform, app_id)
  end
end

# Fastlane's FastFile#sh only forwards log/step_name/error_callback from a
# trailing options hash — `env:` is silently dropped. Pass env as Open3's
# leading Hash (merged with ENV so PATH/HOME/NIX_* survive).
def nix_sh(command, extra_env)
  sh(ENV.to_h.merge(extra_env.transform_keys(&:to_s)), command, log: true)
end

# Impure store signing needs the *runner* uid: nixbld cannot mkdir/write
# /Users/runner (match profiles + fastlane_tmp_keychain). sandbox false alone
# is not enough on multi-user Determinate Nix.
def nix_impure_build_cmd(attr)
  "nix build .##{attr} --impure --option sandbox false " \
    "--option build-users-group \"\" " \
    "--print-out-paths --print-build-logs"
end


def nix_ipa_path(attr, bundle_id: MAIN_BUNDLE_ID, profile_name: nil)
  profile = profile_name || ENV["WAWONA_PROVISIONING_PROFILE_SPECIFIER"] || "match AppStore #{bundle_id}"
  profiles_dir = File.join(Dir.tmpdir, "wawona-match-profiles-#{Process.pid}")
  FileUtils.mkdir_p(profiles_dir)
  staged = Dir.glob(File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles/*.mobileprovision"))
  staged.each { |src| FileUtils.cp(src, profiles_dir) }
  UI.user_error!("No match profiles staged under #{profiles_dir}") if staged.empty?
  stage_distribution_cert_for_nix! if ENV["WAWONA_DIST_KEYCHAIN"].to_s.empty?
  env = nix_build_env.merge(
    # Eval-time (--impure) path inputs for ios.nix / build-app matchHostSigning.
    # Cert material: host keychain + pass-file paths only (never log contents).
    "WAWONA_HOST_HOME" => ENV.fetch("HOME"),
    "WAWONA_PROFILES_DIR" => profiles_dir,
    "WAWONA_CODE_SIGN_STYLE" => ENV.fetch("WAWONA_CODE_SIGN_STYLE", "Manual"),
    "WAWONA_CODE_SIGN_IDENTITY" => ENV.fetch("WAWONA_CODE_SIGN_IDENTITY", "Apple Distribution"),
    "WAWONA_PROVISIONING_PROFILE_SPECIFIER" => profile,
    "WAWONA_DIST_KEYCHAIN" => ENV.fetch("WAWONA_DIST_KEYCHAIN"),
    "WAWONA_DIST_P12_PASS_FILE" => ENV.fetch("WAWONA_DIST_P12_PASS_FILE")
  )
  UI.message(
    "Building #{attr} (version #{env['WAWONA_VERSION']}, build #{env['WAWONA_BUILD_NUMBER']}, " \
    "profiles=#{staged.size}, dist_keychain=staged)"
  )
  # sandbox false + empty build-users-group: import staged P12 into build keychain.
  out = nix_sh(nix_impure_build_cmd(attr), env).strip.split("\n").last
  ipa = Dir.glob(File.join(out, "**", "*.ipa")).first
  UI.user_error!("No IPA found in #{out} for #{attr}") unless ipa
  ipa
end

def nix_aab_path
  env = {
    # BASE64 is required for sandboxed/daemon builds; path alone is unreadable.
    "ANDROID_KEYSTORE_BASE64" => ENV.fetch("ANDROID_KEYSTORE_BASE64"),
    "ANDROID_KEYSTORE_PASSWORD" => ENV.fetch("ANDROID_KEYSTORE_PASSWORD"),
    "ANDROID_KEY_ALIAS" => ENV.fetch("ANDROID_KEY_ALIAS"),
    "ANDROID_KEY_PASSWORD" => ENV.fetch("ANDROID_KEY_PASSWORD")
  }
  out = nix_sh(nix_impure_build_cmd("wawona-android-aab"), env).strip.split("\n").last
  aab = Dir.glob(File.join(out, "**", "*.aab")).first
  UI.user_error!("No AAB found in #{out}") unless aab
  aab
end

platform :ios do
  desc "Upload iPhone, iPad, Apple TV, Apple Vision Pro, and Apple Watch to TestFlight (excludes macOS)"
  lane :beta do
    validate_env
    setup_ci if ENV["CI"]
    api_key = asc_api_key
    begin
      install_testflight_profiles!(api_key)
      ensure_all_asc_versions!(api_key)

      APPLE_BETA_TARGETS.each do |target|
        ipa = nix_ipa_path(
          target[:ipa],
          bundle_id: target[:bundle_id],
          profile_name: target[:profile_name]
        )
        upload_to_testflight(
          **testflight_upload_options(api_key, target),
          ipa: ipa
        )
        if beta_testflight_groups.any?
          UI.success(
            "Uploaded and distributed #{target[:name]} #{wawona_version} (#{wawona_build_number}) " \
            "to TestFlight groups: #{beta_testflight_groups.join(', ')}"
          )
        else
          UI.success("Uploaded #{target[:name]} #{wawona_version} (#{wawona_build_number}) to TestFlight")
        end
      end
    ensure
      cleanup_staged_distribution_cert!
    end
  end

  desc "Submit iOS builds for App Store review"
  lane :release do
    validate_env
    setup_ci if ENV["CI"]
    api_key = asc_api_key
    begin
      install_testflight_profiles!(api_key)
      ensure_all_asc_versions!(api_key)

      APPLE_BETA_TARGETS.each do |target|
        ipa = nix_ipa_path(
          target[:ipa],
          bundle_id: target[:bundle_id],
          profile_name: target[:profile_name]
        )
        deliver(
          api_key: api_key,
          app_identifier: target[:bundle_id],
          platform: target[:app_platform],
          ipa: ipa,
          submit_for_review: true,
          force: true,
          skip_screenshots: true,
          skip_metadata: true,
          run_precheck_before_submit: false
        )
        UI.success("Submitted #{target[:name]} #{wawona_version} (#{wawona_build_number}) for App Store review")
      end
    ensure
      cleanup_staged_distribution_cert!
    end
  end
end

platform :android do
  desc "Upload Android AAB to Play internal track"
  lane :beta do
    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.aspauldingcode.wawona"),
      track: "internal",
      aab: nix_aab_path,
      json_key_data: ENV.fetch("PLAY_STORE_JSON_KEY"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

desc "Upload Apple + Android beta builds"
lane :beta do
  ios_beta
  android_beta
end
