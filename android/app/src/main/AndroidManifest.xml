<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aspauldingcode.wawona">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Package visibility (Android 11+): allow the desktop-replacement app drawer
      to enumerate launchable Android apps. This is the documented, Play-Store
      compliant way to query apps — no QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Wawona"
        android:hasCode="true"
        android:supportsRtl="true">
        
        <activity android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Desktop Replacement: lets the user choose Wawona as the device HOME
              app (Android Launcher). Wawona then presents a Wayland desktop plus
              an app drawer of Android apps and configured Wayland clients.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- One freeform/adjacent Android task per claimed Wayland toplevel. -->
        <activity
            android:name=".SessionActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density"
            android:windowSoftInputMode="adjustNothing" />

        <!-- Android Auto: template-based status dashboard (Car App Library). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <service
            android:name=".WawonaCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>
    </application>

</manifest>
